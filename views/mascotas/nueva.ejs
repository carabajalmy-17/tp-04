<section class="panel-formulario">

    <p class="etiqueta">Nuevo registro</p>

    <h1>Nueva mascota</h1>

    <% if (error) { %>

        <p class="error" role="alert">
            <%= error %>
        </p>

    <% } %>

    <form
        class="formulario"
        action="/mascotas"
        method="post"
    >

        <label for="nombre">Nombre</label>
        <input
            type="text"
            id="nombre"
            name="nombre"
            value="<%= datos.nombre || '' %>"
        >

        <label for="especie">Especie</label>
        <input
            type="text"
            id="especie"
            name="especie"
            value="<%= datos.especie || '' %>"
        >

        <label for="edad">Edad</label>
        <input
            type="number"
            id="edad"
            name="edad"
            min="0"
            value="<%= datos.edad ?? '' %>"
        >

        <label for="estado">Estado</label>
        <select id="estado" name="estado">

            <option value="">Seleccione un estado</option>

            <option
                value="En adopción"
                <%= datos.estado === 'En adopción' ? 'selected' : '' %>
            >
                En adopción
            </option>

            <option
                value="Reservada"
                <%= datos.estado === 'Reservada' ? 'selected' : '' %>
            >
                Reservada
            </option>

            <option
                value="Adoptada"
                <%= datos.estado === 'Adoptada' ? 'selected' : '' %>
            >
                Adoptada
            </option>

        </select>

        <label for="descripcion">Descripción</label>
        <textarea
            id="descripcion"
            name="descripcion"
            rows="5"
        ><%= datos.descripcion || '' %></textarea>

        <button type="submit">
            Agregar mascota
        </button>

    </form>

</section>